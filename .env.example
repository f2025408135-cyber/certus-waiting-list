# Copy to .env.local (never commit .env.local) and set real values in Netlify.
# Example for a local Postgres docker container — the URL contains the
# database user and password before the @ sign (e.g. postgresql://<host>:<port>/<dbname>):
#   DATABASE_URL=postgresql://localhost:5433/certus_waitlist
DATABASE_URL=

# Set to "require" for Neon/Supabase/Vercel Postgres (SSL). Leave empty for local docker.
DATABASE_SSL=

# Admin secret protecting GET /api/waitlist/export (the CSV download). Choose a long random value.
WAITLIST_ADMIN_SECRET=

# Rate limiting (optional, sensible defaults)
# WAITLIST_RATE_LIMIT_MAX=10
# WAITLIST_RATE_LIMIT_WINDOW_MS=60000
